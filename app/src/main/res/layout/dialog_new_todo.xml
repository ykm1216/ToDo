<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF" android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/checkboxNewTodo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edittextTodoTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="New To-Do"
            android:background="@null"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:layout_marginStart="8dp"/>

        <ImageView
            android:id="@+id/imageviewCloseTodo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/x"
            android:contentDescription="Close"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edittextTodoNotes"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="Add notes"
        android:background="@null"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:textColor="#4A5568"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/imageviewCalendarIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/calendar_active"
            android:layout_marginEnd="16dp"
            android:contentDescription="Set date"/>

        <ImageView
            android:id="@+id/imageviewTagIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/label"
            android:layout_marginEnd="16dp"
            android:contentDescription="Set tag"/>

        <ImageView
            android:id="@+id/imageviewProjectIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/project_active"
            android:layout_marginEnd="0dp"
            android:contentDescription="Add to project"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonSaveTodo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#1E293B"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>