<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".screens.projects.ProjectsActivity">

    <!-- SEARCH -->
    <EditText
        android:id="@+id/edittextSearchProjects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search"
        android:textColorHint="#94A3B8"
        android:textColor="#1E293B"
        android:background="@drawable/edittext_border"
        android:paddingStart="16dp"
        android:paddingEnd="40dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:drawableEnd="@drawable/search_icon"
        android:drawablePadding="8dp"/>

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Projects"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"/>

    <!-- SCROLLABLE PROJECT LIST -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/linearlayoutProjectContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"/>

    </androidx.core.widget.NestedScrollView>

    <!-- ADD (+) BUTTON above nav -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:paddingTop="4dp">

        <ImageButton
            android:id="@+id/imagebuttonAddTaskProjects"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/add_task_button"
            android:contentDescription="Add Task"
            android:scaleType="fitCenter"/>
    </RelativeLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0"/>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout android:id="@+id/linearlayoutNavTodo"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/imageviewNavTodo"
                android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/todo_not_active"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="To Do" android:textSize="11sp" android:textColor="#94A3B8" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/linearlayoutNavProjects"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/imageviewNavProjects"
                android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/project_active"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Projects" android:textSize="11sp" android:textColor="#1E293B"
                android:textStyle="bold" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/linearlayoutNavCalendar"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/imageviewNavCalendar"
                android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/calendar_not_active"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Calendar" android:textSize="11sp" android:textColor="#94A3B8" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/linearlayoutNavProfile"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/profile_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Profile" android:textSize="11sp" android:textColor="#94A3B8" android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>