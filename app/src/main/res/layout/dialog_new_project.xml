<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Title row: checkbox + input + X -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/checkboxNewProject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edittextProjectTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="New Project"
            android:background="@null"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:layout_marginStart="8dp"/>

        <ImageView
            android:id="@+id/imageviewCloseProject"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/x"
            android:contentDescription="Close"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Notes -->
    <EditText
        android:id="@+id/edittextProjectNotes"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="Add notes"
        android:background="@null"
        android:gravity="top"
        android:textColor="#4A5568"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"/>

    <!-- Bottom action row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/imageviewProjectCalendarIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/calendar_active"
            android:layout_marginEnd="16dp"
            android:contentDescription="Set date"/>

        <ImageView
            android:id="@+id/imageviewProjectTagIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/label"
            android:layout_marginEnd="16dp"
            android:contentDescription="Set tag"/>

        <View android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>

        <Button
            android:id="@+id/buttonSaveProject"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Save"
            android:backgroundTint="#1E293B"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>