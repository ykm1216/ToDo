<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".screens.dashboard.DashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/edittext_border"
        android:layout_margin="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textviewSearchPlaceholder"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textColor="#94A3B8"
            android:paddingStart="8dp" />

        <ImageView
            android:id="@+id/imageviewSearchIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/search_icon"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textviewHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To do"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/linearlayoutWelcomeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/edittext_border"
        android:padding="20dp"
        android:layout_marginHorizontal="16dp">

        <TextView
            android:id="@+id/textViewUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to To Do!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D3748" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginVertical="12dp" />

        <TextView
            android:id="@+id/textviewWelcomeBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organize your life.\nFocus on what matters today."
            android:textColor="#4A5568"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <TextView android:id="@+id/textviewTaskInfo1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="📌  Tap + to add your first task" android:textStyle="bold" />
            <TextView android:id="@+id/textviewTaskInfo2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="📊  Track your progress" android:textStyle="bold" />
            <TextView android:id="@+id/textviewTaskInfo3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="🎯  Your balance starts here" android:textStyle="bold" />
            <TextView android:id="@+id/textviewTaskInfo4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧘  Clarity over chaos" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">
        <TextView
            android:id="@+id/textviewSectionToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/textviewSectionUpcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upcoming"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/textviewSectionAnytime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anytime"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/textviewSectionDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Done"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:paddingVertical="8dp" />



        <ListView
            android:id="@+id/listViewTasks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#E2E8F0"
            android:dividerHeight="1dp"
            android:scrollbars="none"/>
        <TextView
            android:id="@+id/textviewTrashButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="🗑 Trash"
            android:textColor="#94A3B8"
            android:textSize="14sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom|center_vertical"
            android:paddingVertical="16dp">

            <ImageButton
                android:id="@+id/imagebuttonAddTask"
                android:layout_width="458dp"
                android:layout_height="56dp"
                android:background="@drawable/edittext_border"
                android:contentDescription="Add Task"
                android:gravity="end"
                android:scaleType="fitCenter"
                android:src="@drawable/add_task_button" />

        </LinearLayout>


    </LinearLayout>

    <View
        android:id="@+id/viewNavBorder"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#E2E8F0" />

    <LinearLayout
        android:id="@+id/linearlayoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/linearlayoutNavTodo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/check_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="To Do"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayoutNavCalendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/calendar_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calendar"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayoutNavProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/profile_icon" />

            <TextView
                android:id="@+id/textviewProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Profile"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>