<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".screens.dashboard.DashboardActivity">

    <!-- SEARCH -->
    <EditText
        android:id="@+id/edittextSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search"
        android:textColorHint="#94A3B8"
        android:textColor="#1E293B"
        android:background="@drawable/edittext_border"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:paddingEnd="18dp"
        android:drawableEnd="@drawable/search_icon"
        android:drawablePadding="12dp"/>

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To do"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- WELCOME CARD: visible before any task is added -->
            <LinearLayout
                android:id="@+id/linearlayoutWelcomeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/edittext_border"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/textViewUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome!"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2D3748"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organize your life.\nFocus on what matters today."
                    android:textColor="#4A5568"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" android:text="📌  Tap + to add your first task" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" android:text="📊  Track your progress" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" android:text="🎯  Your balance starts here" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🧘  Clarity over chaos" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- TASK ROWS injected dynamically (sections: Today, Inbox, Upcoming, Anytime, Done) -->
            <LinearLayout
                android:id="@+id/linearlayoutTaskContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:nestedScrollingEnabled="false"/>

            <!-- TRASH at very bottom -->
            <TextView
                android:id="@+id/textviewTrashButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="🗑 Trash"
                android:textColor="#94A3B8"
                android:textSize="14sp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ADD (+) BUTTON pinned top-right above nav -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:paddingTop="4dp">

        <ImageButton
            android:id="@+id/imagebuttonAddTask"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:background="@null"
            android:contentDescription="Add Task"
            android:scaleType="fitCenter"
            android:src="@drawable/add_task_button"/>
    </RelativeLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0"/>

    <!-- BOTTOM NAV (4 tabs) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/linearlayoutNavTodo"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/imageviewNavTodo"
                android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/todo_active"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="To Do"
                android:textSize="11sp" android:textStyle="bold" android:textColor="#1E293B"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayoutNavProjects"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/imageviewNavProjects"
                android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/project_not_active"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Projects"
                android:textSize="11sp" android:textColor="#94A3B8"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayoutNavCalendar"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/imageviewNavCalendar"
                android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/calendar_not_active"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Calendar"
                android:textSize="11sp" android:textColor="#94A3B8"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayoutNavProfile"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/profile_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Profile"
                android:textSize="11sp" android:textColor="#94A3B8"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>