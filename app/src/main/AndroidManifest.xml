<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.todo">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="TodoApp"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".screens.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".screens.profile.ProfileActivity" android:exported="false" />
        <activity android:name=".screens.register.RegisterActivity" />
        <activity android:name=".screens.dashboard.DashboardActivity" />

        <activity android:name=".screens.calendar.CalendarActivity" />
        <activity android:name=".screens.dashboard.SectionListActivity" android:exported="false" />
        <activity android:name=".screens.dashboard.TrashActivity" android:exported="false" />

    </application>
</manifest>